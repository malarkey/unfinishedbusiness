<script>
document.addEventListener('DOMContentLoaded', () => {
gsap.registerPlugin(MorphSVGPlugin);

// ARM - ANDY
const arm = document.getElementById('andy-arm');
gsap.set(arm, { transformOrigin: "center center", transformBox: "fill-box" });

gsap.timeline({
repeat: -1,
repeatDelay: 7 })
.to(arm, { duration: 1, x: -10, y: 10, rotation: 2 })
.to(arm, { duration: 1, x: 0, y: -10, rotation: -1 })
.to(arm, { duration: 1, x: 0, y: 0, rotation: 0 });

// ANDY EYEBROWS
const andyEyebrows = document.getElementById('andy-eyebrows');
gsap.set(andyEyebrows, { transformBox: "fill-box" });

gsap.timeline({
repeat: -1,
repeatDelay: 7 })

.to(andyEyebrows, { duration: 0.5, y: -5, ease: "power1.out" })
.to(andyEyebrows, { duration: 5, y: -5 })
.to(andyEyebrows, { duration: 0.5, y: 0, ease: "power1.in" })
.to({}, { duration: 4 });

// RICH EYEBROWS
const richEyebrows = document.getElementById('rich-eyebrows');
gsap.set(richEyebrows, { transformBox: "fill-box" });

// ANDY HEAD
const andyHead = document.getElementById('andy-head');
gsap.set(andyHead, {
transformOrigin: "center bottom",
transformBox: "fill-box" });

gsap.timeline({ repeat: -1 })
.to(andyHead, { duration: 2, rotation: -0.5, y: -0.2 })
.to(andyHead, { duration: 2.5, rotation: 0.5, y: 0 })
.to(andyHead, { duration: 3, rotation: 0, ease: "elastic.out(1, 0.3)" })
.to({}, { duration: 2 });

// RICH HEAD
const richHead = document.getElementById('rich-head');
gsap.set(richHead, {
transformOrigin: "center bottom",
transformBox: "fill-box" });

const richTimeline = gsap.timeline({ repeat: -1, defaults: { ease: "sine.inOut" } })
.to(richHead, { duration: 1.5, rotation: .2, y: 1 }, 0)
.to(richEyebrows, { duration: 0.75, y: -4, ease: "power2.out" }, 0)
.to(richEyebrows, { duration: 0.75, y: -4 }, 0.75)
.to(richHead, { duration: 2, rotation: -0.2, y: 0 }, 1.5)
.to(richEyebrows, { duration: 1, y: -2 }, 1.5)
.to(richHead, { duration: 2.5, rotation: 0, y: 0, ease: "elastic.out(1, 0.4)" }, 3.5)
.to(richEyebrows, { duration: 1.25, y: 0, ease: "power1.in" }, 3.5)
.to({}, { duration: 1.5 }, 6);

// ANDY LINES
const andyLines = gsap.utils.toArray("#andy-lines path");
gsap.set(andyLines, { strokeWidth: 0 });

gsap.timeline({
repeat: -1,
repeatDelay: 8 })

.to(andyLines[0], { duration: 0.3, strokeWidth: 2, ease: "power1.out" })
.to(andyLines[1], { duration: 0.3, strokeWidth: 2, ease: "power1.out" }, "-=0.15")
.to(andyLines[2], { duration: 0.3, strokeWidth: 2, ease: "power1.out" }, "-=0.15")
.to(andyLines, { duration: 0.5, strokeWidth: 0, delay: 1, ease: "power1.in" });

// RICH LINES
const richLines = gsap.utils.toArray("#rich-lines path");
gsap.set(richLines, { strokeWidth: 0 });

gsap.timeline({
repeat: -1,
repeatDelay: 7 })

.to(richLines[0], { duration: 0.4, strokeWidth: 2, ease: "power2.out" })
.to(richLines[1], { duration: 0.4, strokeWidth: 2, ease: "power2.out" }, "-=0.2")
.to(richLines[2], { duration: 0.4, strokeWidth: 2, ease: "power2.out" }, "-=0.2")
.to(richLines, { duration: 0.6, strokeWidth: 0, delay: 1.5, ease: "power2.in" });

// ANDY BLINK
const andyEyes = document.getElementById('andy-eyes');
const andyOpenEyes = andyEyes.getAttribute('d');
const andyClosedEyes = "M590.5 244c0 0-3-0.5-6.5-0.5s-6.5 0.5-6.5 0.5 3 0 6.5 0 6.5-0.5 6.5-0.5Zm73-1c0 0-3-0.5-6.5-0.5s-6.5 0.5-6.5 0.5 3 0 6.5 0 6.5-0.5 6.5-0.5Z";

// RICH BLINK
const richEyes = document.getElementById('rich-eyes');
const richOpenEyes = richEyes.getAttribute('d');
const richClosedEyes = "M974.5 232c0 0-3-0.5-6.5-0.5s-6.5 0.5-6.5 0.5 3 0 6.5 0 6.5-0.5 6.5-0.5Zm73-1c0 0-3-0.5-6.5-0.5s-6.5 0.5-6.5 0.5 3 0 6.5 0 6.5-0.5 6.5-0.5Z";

// ANDY BLINK PATTERN
function andyBlink() {
gsap.timeline()
.to(andyEyes, { duration: 0.08, morphSVG: andyClosedEyes, ease: "power2.in" })
.to(andyEyes, {
duration: 0.12,
morphSVG: andyOpenEyes,
ease: "power2.out",
onComplete: () => {
gsap.delayedCall(3 + Math.random() * 2, andyBlink); }
});

if(Math.random() < 0.2) {
gsap.delayedCall(0.3, () => {
gsap.to(andyEyes, { duration: 0.06, morphSVG: andyClosedEyes })
.to(andyEyes, { duration: 0.1, morphSVG: andyOpenEyes }); });
}
}

// RICH BLINK PATTERN
function richBlink() {
gsap.timeline()
.to(richEyes, {
duration: 0.15,
morphSVG: richClosedEyes,
ease: "power2.in",
onStart: () => {
gsap.to(richHead, { duration: 0.2, y: "+=2", ease: "sine.out" }); }
})
.to(richEyes, {
duration: 0.2,
morphSVG: richOpenEyes,
ease: "elastic.out(1, 0.5)",
onComplete: () => {
gsap.to(richHead, { duration: 0.3, y: 0, ease: "sine.inOut" });
gsap.delayedCall(5 + Math.random() * 4, richBlink); }
});
}

// START BLINKING
gsap.delayedCall(1, andyBlink);
gsap.delayedCall(2.5, richBlink);

document.addEventListener('click', () => {
andyBlink();
richBlink(); });
});
</script>


<script>
class AudioPlayer extends HTMLElement {
constructor() {
super();
const template = document.querySelector('template');
const templateContent = template.content;
const shadow = this.attachShadow({ mode: 'open' });
shadow.appendChild(templateContent.cloneNode(true));
}

connectedCallback() {
initAudioPlayer(this);
}
}

const initAudioPlayer = (element) => {
const shadow = element.shadowRoot;

const audioPlayerContainer = shadow.getElementById('audio-player-container');
const playIconContainer = shadow.getElementById('play-icon');
const seekSlider = shadow.getElementById('seek-slider');
const volumeSlider = shadow.getElementById('volume-slider');
const muteIconContainer = shadow.getElementById('mute-icon');
const audio = shadow.querySelector('audio');
const durationContainer = shadow.getElementById('duration');
const currentTimeContainer = shadow.getElementById('current-time');
const outputContainer = shadow.getElementById('volume-output');

let playState = 'play';
let muteState = 'unmute';
let raf = null;

// Set audio src from attribute
audio.src = element.getAttribute('data-src');

// SVG icons
const playSVG = `
<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="none" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#734026" fill-rule="evenodd" d="M46.5 24a22.5 22.5 0 1 0-45 0 22.5 22.5 0 0 0 45 0Zm-29.8-7.4a127 127 0 0 0 0 14.8c0 1.7 1 3.1 2.4 3.8 1.4.6 3 .5 4.5-.5l4.5-3c2.1-1.4 3.7-2.8 4.8-4 2-2.1 2-5.3 0-7.4a32.7 32.7 0 0 0-4.8-4l-4.5-3c-1.4-1-3-1.1-4.5-.5-1.4.7-2.3 2-2.4 3.8Z" clip-rule="evenodd"/></svg>`;
const pauseSVG = `
<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="none" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#fde800" fill-rule="evenodd" d="M24 47.5a23.5 23.5 0 1 1 0-47 23.5 23.5 0 0 1 0 47ZM13 31c.1 1.6 1.1 2.8 2.6 3a19.4 19.4 0 0 0 2.8 0c1.5-.2 2.5-1.4 2.5-3l.1-7v-7c-.1-1.6-1.1-2.8-2.6-3a19.4 19.4 0 0 0-2.8 0c-1.5.2-2.5 1.4-2.5 3l-.1 7v7Zm14 0c.1 1.6 1.1 2.8 2.6 3a19.4 19.4 0 0 0 2.8 0c1.5-.2 2.5-1.4 2.5-3l.1-7v-7c-.1-1.6-1.1-2.8-2.6-3a19.4 19.4 0 0 0-2.8 0c-1.5.2-2.5 1.4-2.5 3l-.1 7v7Z" clip-rule="evenodd"/></svg>`;
const volumeOnSVG = `
<svg xmlns="http://www.w3.org/2000/svg" fill="none" width="40" height="40" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#734026" fill-rule="evenodd" d="m11.5 11.8.5-3.2a53.7 53.7 0 0 1 11.3-7c2.7-1 5.3 1 5.5 3.6a229.9 229.9 0 0 1 0 37.6c-.2 2.7-2.8 4.6-5.5 3.6a42 42 0 0 1-11.3-7l-.5-3.2a33.5 33.5 0 0 1-.5-3.6 80.5 80.5 0 0 1 .5-20.8Zm-3 24.9a80.3 80.3 0 0 1-4.2-1.2c-1.7-.6-2.9-2-3.2-3.8a46.4 46.4 0 0 1 0-15.4 4.8 4.8 0 0 1 3.2-3.8 61.8 61.8 0 0 1 4.2-1.2A29.9 29.9 0 0 0 8 15a83.4 83.4 0 0 0 .5 21.7Zm31-2.1a14.9 14.9 0 0 0 0-21.2 2 2 0 1 1 3-2.8 18.9 18.9 0 0 1 0 26.8 2 2 0 1 1-3-2.8Zm-5-4c3.3-3.6 3.3-9.6 0-13.3a2 2 0 0 1 3-2.6 14.2 14.2 0 0 1 0 18.6 2 2 0 0 1-3-2.6Z" clip-rule="evenodd"/></svg>`;
const volumeOffSVG = `
<svg xmlns="http://www.w3.org/2000/svg" fill="none" width="40" height="40" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#fde800" fill-rule="evenodd" d="m11.5 11.8.5-3.2a53.7 53.7 0 0 1 11.3-7c2.7-1 5.3 1 5.5 3.6a229.9 229.9 0 0 1 0 37.6c-.2 2.7-2.8 4.6-5.5 3.6a42 42 0 0 1-11.3-7l-.5-3.2a33.5 33.5 0 0 1-.5-3.6 80.5 80.5 0 0 1 .5-20.8Zm-3 24.9a80.3 80.3 0 0 1-4.2-1.2c-1.7-.6-2.9-2-3.2-3.8a46.4 46.4 0 0 1 0-15.4 4.8 4.8 0 0 1 3.2-3.8 61.8 61.8 0 0 1 4.2-1.2A29.9 29.9 0 0 0 8 15a83.4 83.4 0 0 0 .5 21.7Zm25-19.6a2 2 0 0 1 3 0l4 4 4-4a2 2 0 1 1 3 2.8L43.2 24l4.1 4a2 2 0 1 1-2.8 3l-4.1-4.2-4 4.1a2 2 0 1 1-3-2.8l4.2-4.1-4.1-4a2 2 0 0 1 0-3Z" clip-rule="evenodd"/></svg>`;

const setPlayIcon = (state) => {
playIconContainer.innerHTML = (state === 'play') ? playSVG : pauseSVG;
playIconContainer.setAttribute('aria-label', state === 'play' ? 'Play' : 'Pause');
};

const setMuteIcon = (state) => {
muteIconContainer.innerHTML = (state === 'unmute') ? volumeOnSVG : volumeOffSVG;
muteIconContainer.setAttribute('aria-label', state === 'unmute' ? 'Mute' : 'Unmute');
};

// Initialize icons
setPlayIcon('play');
setMuteIcon('unmute');

// Time format helper
const calculateTime = (secs) => {
const minutes = Math.floor(secs / 60);
const seconds = Math.floor(secs % 60);
return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
};

// Update buffered amount style
const displayBufferedAmount = () => {
try {
if (audio.buffered.length > 0) {
const bufferedAmount = Math.floor(audio.buffered.end(audio.buffered.length - 1));
audioPlayerContainer.style.setProperty('--buffered-width', `${(bufferedAmount / seekSlider.max) * 100}%`);
}
} catch (e) {}
};

// Update duration & slider max
const displayDuration = () => {
if (!isNaN(audio.duration)) durationContainer.textContent = calculateTime(audio.duration);
};

const setSliderMax = () => {
if (!isNaN(audio.duration)) seekSlider.max = Math.floor(audio.duration);
};

// While playing UI update loop
const whilePlaying = () => {
seekSlider.value = Math.floor(audio.currentTime);
currentTimeContainer.textContent = calculateTime(seekSlider.value);
audioPlayerContainer.style.setProperty('--seek-before-width', `${seekSlider.value / seekSlider.max * 100}%`);
raf = requestAnimationFrame(whilePlaying);
};

// Show range progress bar for seek or volume sliders
const showRangeProgress = (rangeInput) => {
if (rangeInput === seekSlider) audioPlayerContainer.style.setProperty('--seek-before-width', rangeInput.value / rangeInput.max * 100 + '%');
else audioPlayerContainer.style.setProperty('--volume-before-width', rangeInput.value / rangeInput.max * 100 + '%');
};

// Setup audio events to update UI
if (audio.readyState > 0) {
displayDuration();
setSliderMax();
displayBufferedAmount();
} else {
audio.addEventListener('loadedmetadata', () => {
displayDuration();
setSliderMax();
displayBufferedAmount();
});
}

audio.addEventListener('progress', displayBufferedAmount);

// Play/pause button handler
playIconContainer.addEventListener('click', () => {
if (playState === 'play') {
audio.play();
setPlayIcon('pause');
requestAnimationFrame(whilePlaying);
playState = 'pause';

// Update Media Session metadata on play
updateMediaSession(element);
} else {
audio.pause();
setPlayIcon('play');
cancelAnimationFrame(raf);
playState = 'play';
}
});

// Mute/unmute button handler
muteIconContainer.addEventListener('click', () => {
if (muteState === 'unmute') {
audio.muted = true;
setMuteIcon('mute');
muteState = 'mute';
} else {
audio.muted = false;
setMuteIcon('unmute');
muteState = 'unmute';
}
});

// Seek slider handlers
seekSlider.addEventListener('input', (e) => {
showRangeProgress(e.target);
currentTimeContainer.textContent = calculateTime(seekSlider.value);
if (!audio.paused) cancelAnimationFrame(raf);
});

seekSlider.addEventListener('change', () => {
audio.currentTime = seekSlider.value;
if (!audio.paused) requestAnimationFrame(whilePlaying);
});

// Volume slider handler
volumeSlider.addEventListener('input', (e) => {
const value = e.target.value;
showRangeProgress(e.target);
outputContainer.textContent = value;
audio.volume = value / 100;
});

// Media Session controls integration
if ('mediaSession' in navigator) {
// Setup action handlers scoped to this player

navigator.mediaSession.setActionHandler('play', () => {
if (playState === 'play') {
audio.play();
setPlayIcon('pause');
requestAnimationFrame(whilePlaying);
playState = 'pause';
updateMediaSession(element);
}
});

navigator.mediaSession.setActionHandler('pause', () => {
if (playState === 'pause') {
audio.pause();
setPlayIcon('play');
cancelAnimationFrame(raf);
playState = 'play';
}
});

navigator.mediaSession.setActionHandler('seekbackward', (details) => {
audio.currentTime = Math.max(audio.currentTime - (details.seekOffset || 10), 0);
});

navigator.mediaSession.setActionHandler('seekforward', (details) => {
audio.currentTime = Math.min(audio.currentTime + (details.seekOffset || 10), audio.duration);
});

navigator.mediaSession.setActionHandler('seekto', (details) => {
if (details.fastSeek && 'fastSeek' in audio) {
audio.fastSeek(details.seekTime);
return;
}
audio.currentTime = details.seekTime;
});

navigator.mediaSession.setActionHandler('stop', () => {
audio.currentTime = 0;
seekSlider.value = 0;
audioPlayerContainer.style.setProperty('--seek-before-width', '0%');
currentTimeContainer.textContent = '0:00';
if (playState === 'pause') {
setPlayIcon('play');
cancelAnimationFrame(raf);
playState = 'play';
}
});
}
};

// Update Media Session metadata for the player passed in
function updateMediaSession(element) {
if (!('mediaSession' in navigator)) return;

navigator.mediaSession.metadata = new MediaMetadata({
title: element.getAttribute('data-title') || 'Unknown title',
artist: element.getAttribute('data-artist') || '',
album: element.getAttribute('data-album') || '',
artwork: [
{ src: element.getAttribute('data-artwork') || '', sizes: '96x96', type: 'image/png' },
{ src: element.getAttribute('data-artwork') || '', sizes: '128x128', type: 'image/png' },
{ src: element.getAttribute('data-artwork') || '', sizes: '192x192', type: 'image/png' },
{ src: element.getAttribute('data-artwork') || '', sizes: '256x256', type: 'image/png' },
]
});
}

customElements.define('audio-player', AudioPlayer);</script>