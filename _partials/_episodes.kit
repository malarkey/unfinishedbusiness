<section id="episodes">

<!-- https://css-tricks.com/lets-create-a-custom-audio-player/ -->

<template>
<style>
#audio-player-container {
background-color: #fff;
border-radius: var(--border-radius-l);
display: grid;
gap: var(--spacing-s) var(--spacing-s);
grid-template-areas:
  "artwork play-icon current-time seek-slider duration"
  "artwork play-icon volume-output volume-slider mute-icon";
grid-template-columns: 160px 80px 60px 1fr 60px;
grid-template-rows: 1fr 1fr;
margin-block-end: var(--spacing-s);
padding: var(--spacing-r);
width: 100%;
--buffered-width: 0%;
--seek-before-width: 0%;
--volume-before-width: 100%; }

#audio-player-container > * {
align-self: center;
margin-trim: block; }

#audio-player-container #artwork {
grid-area: artwork; }

#audio-player-container #artwork > img {
inline-size: 100%;
margin: 0;
max-inline-size: 100%; }

#audio-player-container #current-time {
display: block;
font-size: var(--font-size-s);
grid-area: current-time;
text-align: right; }

#audio-player-container #duration {
display: block;
font-size: var(--font-size-s);
grid-area: duration;
text-align: left; }

#audio-player-container #mute-icon {
background-color: transparent;
border: 0;
cursor: pointer;
grid-area: mute-icon;
outline: none;
padding: 0; }

#audio-player-container #play-icon {
background-color: transparent;
border: 0;
cursor: pointer;
grid-area: play-icon;
margin-inline: auto;
outline: none;
padding: 0; }

#audio-player-container #volume-output {
display: block;
font-size: var(--font-size-s);
grid-area: volume-output;
text-align: right; }

#audio-player-container #volume-slider {
grid-area: volume-slider;
width: 100%; }

#audio-player-container #volume-slider::-moz-range-track {
background-color: var(--color-border); }

#audio-player-container #volume-slider::-ms-fill-upper {
background-color: var(--color-border); }

#audio-player-container #volume-slider::-webkit-slider-runnable-track {
background-color: var(--color-border); }

#audio-player-container #volume-slider::before {
width: var(--volume-before-width); }

#audio-player-container input[type="range"] {
height: 10px;
margin: 0;
outline: none;
padding: 0;
position: relative;
-webkit-appearance: none;
width: 100%; }

#audio-player-container input[type="range"]::-webkit-slider-runnable-track {
background-color: var(--color-background-default);
border-radius: 10px;
cursor: pointer;
height: 10px;
width: 100%; }

#audio-player-container input[type="range"]::-webkit-slider-thumb {
-webkit-appearance: none;
background-color: #fff;
border: 3px solid var(--color-border);
border-radius: 50%;
box-sizing: content-box;
cursor: pointer;
margin: -7px 0 0 0;
width: 17px;
height: 17px; }

#audio-player-container input[type="range"]:active::-webkit-slider-thumb {
background: var(--color-border);
transform: scale(1.2); }
</style>

<div id="audio-player-container">
<audio src="" preload="metadata" loop></audio>

<div id="artwork"><img src="/img/artwork.png" alt="Unfinished Business"></div>
<button id="play-icon"></button>

<span id="current-time" class="time">0:00</span>
<input type="range" id="seek-slider" max="100" value="0">
<span id="duration" class="time">0:00</span>

<output id="volume-output">100</output>
<input type="range" id="volume-slider" max="100" value="100">
<button id="mute-icon"></button>
</div>
</template>




